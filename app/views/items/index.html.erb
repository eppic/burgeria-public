<h1>Items</h1>
<p>Hier finden Sie alle unserer Gerichte</p>

<% @items.each do |item| %>
<div id="items">
    <h2><%= item.name %></h2>
    <ul>
      <li class="item">
        <%= link_to item_path(item), class: 'item-link' do %>
          <div class="item-content">
          <% if item.image.present? %>
          <%= image_tag "menu/#{item.image}", alt: "#{item.name} image" %>
          <% else %>
          <%= image_tag "placeholder.jpg", alt: "Default image" %>
          <% end %>
          <strong><%= item.name %></strong><br>
          </div>
        <% end %>
      </li>
</div>
<% end %>
